# TEV: Together AI serverless (OpenAI-compatible chat completions)
TOGETHER_API_KEY=
TEV_MODEL=together/Tev1-4B-experimental
# USD per 1M tokens (Together /v1/models pricing for this model)
TEV_PRICE_IN=0.042
TEV_PRICE_OUT=0

# JEV: TypeSafe Jev via AI Space (POST {JEV_BASE_URL}/systemone)
AISPACE_API_KEY=
JEV_BASE_URL=https://ai.xyspace.dev/v1
JEV_MODEL=jev-latest
# TypeSafe list price; override if AI Space bills differently
JEV_PRICE_IN=0.042
JEV_PRICE_OUT=0

# Frontier comparison models via AI Space chat completions (same AISPACE_API_KEY)
# GLM 5.3: Cloudflare Workers AI list price; Opus 5.5: Anthropic list price
GLM_PRICE_IN=1.40
GLM_PRICE_OUT=4.40
OPUS_PRICE_IN=4.00
OPUS_PRICE_OUT=20.00
