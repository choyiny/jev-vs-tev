# TEV: Together AI serverless (OpenAI-compatible chat completions)
TOGETHER_API_KEY=
TEV_MODEL=together/Tev1-4B-experimental
# USD per 1M tokens; fill in from together.ai/pricing to get a cost column
TEV_PRICE_IN=
TEV_PRICE_OUT=

# JEV: TypeSafe Jev via AI Space (POST {JEV_BASE_URL}/systemone)
AISPACE_API_KEY=
JEV_BASE_URL=https://ai.xyspace.dev/v1
JEV_MODEL=jev-latest
# TypeSafe list price; override if AI Space bills differently
JEV_PRICE_IN=0.042
JEV_PRICE_OUT=0
